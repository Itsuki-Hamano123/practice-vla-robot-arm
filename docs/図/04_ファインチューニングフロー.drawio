<mxfile host="drawio" version="26.0.0"><diagram id="d1" name="ファインチューニング"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" background="#ffffff" pageWidth="1650" pageHeight="650"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="ファインチューニングフロー（設計.md 8.2・学習設定.md）" style="text;align=left;verticalAlign=top;fontSize=12;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="800" height="24" as="geometry"/></mxCell><mxCell id="c3" value="デモデータセット&#10;outputs/datasets/so101_pick_box&#10;100 エピソード（赤50・青50・左右半々）&#10;約 10,398 フレーム・10Hz&#10;画像2台＋state＋action＋task" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;shape=cylinder3;boundedLbl=1;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="280" height="100" as="geometry"/></mxCell><mxCell id="c4" value="lerobot/smolvla_base&#10;Hugging Face Hub&#10;（事前学習済み SmolVLA）" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;shape=cylinder3;boundedLbl=1;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="280" height="90" as="geometry"/></mxCell><mxCell id="c5" value="scripts/train.sh&#10;[デモデータセット] [出力名]&#10;[steps=5000（既定 20000）]&#10;[batch=32]" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="190" width="220" height="80" as="geometry"/></mxCell><mxCell id="c6" value="scripts/smoke_train.sh&#10;CPU のスモークテスト（任意）" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="370" y="300" width="220" height="60" as="geometry"/></mxCell><mxCell id="gp" value="GPU マシン：policy コンテナ（docker compose exec）  lerobot-train / lerobot 0.4.0" style="swimlane;startSize=28;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="650" y="90" width="560" height="380" as="geometry"/></mxCell><mxCell id="c7" value="デモデータセットの読込&#10;pyav で動画デコード（num_workers=4）&#10;-