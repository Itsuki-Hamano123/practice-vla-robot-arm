<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0"><diagram id="d1" name="推論実行フロー"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" background="#ffffff" pageWidth="1500" pageHeight="700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="推論実行フロー（設計.md 6.2）" style="text;align=left;verticalAlign=top;fontSize=12;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="450" height="24" as="geometry"/></mxCell><mxCell id="usr" value="人: /vla/instruction&#10;'pick up the red box'&#10;（実行中も切替可）" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="20" width="190" height="60" as="geometry"/></mxCell><mxCell id="rrd" value="RerunLogger / Recorder&#10;→ outputs/rrd/&lt;日時&gt;_&lt;指示&gt;.rrd" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="20" width="220" height="60" as="geometry"/></mxCell><mxCell id="st" value="scripts/run_policy.sh&#10;config/policy_*.yaml を読込&#10;モデルロード・/scene/reset" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="190" height="80" as="geometry"/></mxCell><mxCell id="dq" value="行動キューが&#10;空?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="265" width="190" height="90" as="geometry"/></mxCell><mxCell id="pa" value="sim を一時停止&#10;（sync_mode: true のみ）" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="110" width="190" height="60" as="geometry"/></mxCell><mxCell id="ob" value="最新の観測を取得&#10;画像2枚（JPEG）・関節角・指示文" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="110" width="190" height="70" as="geometry"/></mxCell><mxCell id="oa" value="ObsAdapter&#10;デコード・rad→度&#10;camera_map で入力キーへ" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="110" width="190" height="70" as="geometry"/></mxCell><mxCell id="pr" value="PolicyRunner（SmolVLA）&#10;前処理 → 推論 → 後処理&#10;行動チャンク（最大50ステップ）" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="110" width="220" height="80" as="geometry"/></mxCell><mxCell id="aa" value="ActionAdapter&#10;度→rad・可動範囲クリップ&#10;1ステップ ≤ 0.05 rad" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="260" width="210" height="80" as="geometry"/></mxCell><mxCell id="qf" value="行動キューへ格納&#10;sim を再開" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="420" width="210" height="60" as="geometry"/></mxCell><mxCell id="pop" value="キューから&#10;1ステップ取り出す" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="420" width="190" height="60" as="geometry"/></mxCell><mxCell id="pub" value="/arm_controller/commands へ送信&#10;→ ros2_control → Gazebo" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="420" width="190" height="60" as="geometry"/></mxCell><mxCell id="wt" value="制御周期だけ待つ&#10;（Phase B は 10Hz）" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="420" width="190" height="60" as="geometry"/></mxCell><mxCell id="en" value="終了条件?&#10;success / wrong&#10;max_chunks" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="410" width="190" height="90" as="geometry"/></mxCell><mxCell id="fin" value="終了&#10;.rrd を保存" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="590" width="190" height="60" as="geometry"/></mxCell><mxCell id="c3" value="" style="edgeStyle=