<?xml version="1.0"?>
<!-- 机（上面が z=0）・赤箱・青箱。ロボットは launch で原点に spawn する -->
<sdf version="1.6">
  <world name="default">
    <include><uri>model://sun</uri></include>

    <!-- real_time_update_rate は CPU 用の値。GPU マシンでは環境変数 SIM_REAL_TIME_UPDATE_RATE で上書きする（sim.launch.py） -->
    <physics type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_update_rate>80</real_time_update_rate>
    </physics>

    <!-- 状態の取得・設定サービス（/get_entity_state, /set_entity_state）と spawn。
         /model_states・/link_states は 50Hz（疑似固定で箱を手先に追従させるときの遅れを減らす） -->
    <plugin name="gazebo_ros_init" filename="libgazebo_ros_init.so"/>
    <plugin name="gazebo_ros_factory" filename="libgazebo_ros_factory.so"/>
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/</namespace></ros>
      <update_rate>50.0</update_rate>
    </plugin>

    <model name="floor">
      <static>true</static>
      <pose>0 0 -0.02 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="table">
      <static>true</static>
      <pose>0.3 0 -0.01 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>1.0 1.2 0.02</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>1.0 1.2 0.02</size></box></geometry>
          <material><ambient>0.8 0.75 0.65 1</ambient><diffuse>0.8 0.75 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 約 3cm 角の箱。初期位置は scene_manager が reset で上書きする。
         collide_bitmask 0x02：可動指（0x01）とは当たらない（疑似固定 B1。so101.urdf.xacro） -->
    <model name="red_box">
      <pose>0.25 0.08 0.015 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.03</mass>
          <inertia><ixx>4.5e-6</ixx><iyy>4.5e-6</iyy><izz>4.5e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="c">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <surface>
            <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
            <contact><collide_bitmask>0x02</collide_bitmask></contact>
          </surface>
        </collision>
        <visual name="v">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <material><ambient>0.9 0.05 0.05 1</ambient><diffuse>0.9 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="blue_box">
      <pose>0.25 -0.08 0.015 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.03</mass>
          <inertia><ixx>4.5e-6</ixx><iyy>4.5e-6</iyy><izz>4.5e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="c">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <surface>
            <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
            <contact><collide_bitmask>0x02</collide_bitmask></contact>
          </surface>
        </collision>
        <visual name="v">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <material><ambient>0.05 0.1 0.9 1</ambient><diffuse>0.05 0.1 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
